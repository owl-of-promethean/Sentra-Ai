# Sentra AI Environment Variables
# ============================================================

# Groq API key (required for all AI functionality)
# Get a key at https://console.groq.com — never commit real keys.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# SOC Analyst credentials (used by POST /auth/login)
# Set these before running in any non-demo environment.
# If SOC_ANALYST_PASSWORD is not set, the demo fallback password "password" is used.
SOC_ANALYST_EMAIL=admin@sentra.ai
SOC_ANALYST_PASSWORD=change-me-before-production

# JWT signing key — auto-generated per process if not set.
# Set a stable value if you need tokens to survive a server restart.
# JWT_SECRET_KEY=your-256-bit-hex-secret-here

# Token lifetime in hours (default: 8)
# TOKEN_EXPIRE_HOURS=8
